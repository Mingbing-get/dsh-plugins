{
  "name": "@meing/dsh-gomoku-plugin",
  "version": "0.3.1",
  "description": "A waiting, interactive Gomoku tool for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --noEmit && tsdown",
    "prepack": "pnpm build",
    "test": "vitest run",
    "pack:check": "npm_config_cache=/private/tmp/dsh-gomoku-npm-cache npm pack --dry-run",
    "release:github": "node scripts/release.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.0.1-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.0.1-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-0",
    "@deepseek-ai/dsh-user-questions": ">=0.0.1-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../test/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-runtime": "link:../../../test/deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../test/deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../test/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "link:../../../test/deepseek-harness/packages/client/ui-tool",
    "@deepseek-ai/dsh-tools": "link:../../../test/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-user-questions": "link:../../../test/deepseek-harness/packages/interaction/user-questions",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "license": "MIT",
  "packageManager": "pnpm@11.22.0"
}
